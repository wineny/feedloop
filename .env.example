# Copy to .env.local for local development. Vercel: set the same names in the project settings.
# Nothing here is a real value. Lines marked (optional) can be left out for a first run.

# ── Supabase (apply supabase/schema.sql to a fresh project first) ─────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# (optional) Postgres URL — only scripts use it, e.g. psql "$POSTGRES_URL_NON_POOLING" -f supabase/schema.sql
# Use the "Session pooler" string from Connect → Connection string. The direct db.<ref>.supabase.co
# host is IPv6-only and fails from most laptops and CI runners.
POSTGRES_URL_NON_POOLING=postgresql://postgres.your-project-ref:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Auth (NextAuth + Google) ────────────────────────────────────────────────
# Google Cloud console → OAuth client → authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
NEXTAUTH_SECRET=your-random-secret          # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Encryption for stored secrets (bot tokens, operator LLM keys, PayPal secrets) ──
BOT_TOKEN_ENCRYPTION_KEY=your-64-hex-char-key   # openssl rand -hex 32

# ── LLM ─────────────────────────────────────────────────────────────────────
# Platform fallback model used by bots that have no key of their own (src/lib/llm/provider.ts).
PLATFORM_LLM_PROVIDER=anthropic              # anthropic | gemini | openai
PLATFORM_LLM_MODEL=                          # (optional) empty = provider's recommended model
PLATFORM_ANTHROPIC_API_KEY=your-anthropic-api-key
# Fix-PR engine (auto-dev) — Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
# (optional) other providers for bring-your-own-key verification
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ── GitHub (fix PRs) ────────────────────────────────────────────────────────
GITHUB_TOKEN=your-github-personal-access-token   # repo scope; or set up the GitHub App (GITHUB_APP_*)

# ── Deployment ──────────────────────────────────────────────────────────────
WEBHOOK_BASE_URL=http://localhost:3000       # public origin; widget snippets and emails are built from it
CRON_SECRET=your-random-secret               # Vercel cron calls /api/cron/* with Authorization: Bearer <CRON_SECRET>

# ── PayPal sandbox (https://developer.paypal.com/dashboard/) — PayPal AI Hackathon ──
# The demo bot uses these deployment-wide credentials until a per-bot key is saved in settings.
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_ENVIRONMENT=SANDBOX                   # anything else is refused unless PAYPAL_ALLOW_LIVE=1
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# ── (optional) ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                          # only for the Telegram channel
POSTMARK_SERVER_TOKEN=                       # operator emails; without it emails are logged, not sent
EMAIL_FROM_ADDRESS=
NEXT_PUBLIC_POSTHOG_KEY=                     # browser analytics; public key
